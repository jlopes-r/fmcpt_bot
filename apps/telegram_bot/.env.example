API_ID=123456
API_HASH=seu_api_hash
BOT_TOKEN=seu_bot_token
BOT_TOKEN_COMANDOS=seu_token_do_bot_de_comandos
GRUPOS_AUTORIZADOS=123456789,-987654321
ADMIN_ID=123456789
MODO_ZUEIRA=1

# Instagram
IG_USERNAME=
IG_PASSWORD=
IG_COOKIE_PATH=data/instagram_cookies.txt
IG_SECONDARY_COOKIE_PATH=data/instagram_cookies_secondary.txt

# Testes reais opcionais, executados com baixa frequencia na VM.
# Use URLs pequenas e estaveis que voce tem permissao para acessar.
SOCIAL_CONTRACT_URLS={}
SOCIAL_CONTRACT_TIMEOUT=180

# Limites de download (opcionais)
MAX_DOWNLOADS=3
IG_MEDIA_DOWNLOAD_CONCURRENCY=3
IG_MAX_CAROUSEL_ITEMS=20
IG_MAX_STORY_ITEMS=20
IG_YTDLP_TIMEOUT=180
# Circuit breakers por conta/endpoint e cooldowns de autenticação/IP
IG_CIRCUIT_FAILURES=2
IG_CIRCUIT_SECONDS=300
IG_INVALID_COOKIE_COOLDOWN=1800
IG_CHALLENGE_COOLDOWN=3600
IG_429_COOLDOWN=120
# Conjunto versionado de consultas; use overrides somente após teste de contrato
IG_GRAPHQL_DOCSET=polaris-2026-08
IG_GRAPHQL_MODERN_DOC_ID=
IG_GRAPHQL_LEGACY_DOC_IDS=
MAX_MEDIA_BYTES=2000000000
PROFILE_PICTURE_MAX_BYTES=10485760

# Mini App Telegram
# Deve apontar para o servidor do Mini App com validacao de initData + grupo.
# O HTML precisa estar em HTTPS, mas o catalogo so e liberado para membros dos GRUPOS_AUTORIZADOS.
MINI_APP_URL=
MINI_APP_HOST=127.0.0.1
MINI_APP_PORT=8080
MINI_APP_TRUST_PROXY_HEADERS=0
MINI_APP_MEMBERSHIP_CACHE_TTL=120

# Opcionais para rodar fora da VM padrao
ENV_FILE=
DOWNLOADS_DIR=
LOG_DIR=
SESSIONS_DIR=
