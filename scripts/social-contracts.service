[Unit]
Description=Super Bot - testes reais dos contratos das redes sociais
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=30min
User=juanl
WorkingDirectory=@REPO_DIR@
Environment=ENV_FILE=@REPO_DIR@/apps/telegram_bot/.env
EnvironmentFile=@REPO_DIR@/apps/telegram_bot/.env
ExecStart=@REPO_DIR@/.deploy/current-venv/bin/python @REPO_DIR@/scripts/check_social_contracts.py --require-config
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@REPO_DIR@/data
