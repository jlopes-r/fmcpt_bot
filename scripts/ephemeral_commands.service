[Unit]
Description=FMCPT Bot API Ephemeral Commands
After=network.target

[Service]
Type=simple
User=juanl
WorkingDirectory=/home/juanl/bot
Environment=ENV_FILE=/home/juanl/bot/apps/telegram_bot/.env
ExecStart=/home/juanl/bot/venv/bin/python -m apps.ephemeral_commands.service
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
